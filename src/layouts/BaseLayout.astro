---
import Head from "@/components/layouts/Head.astro";
import type { HeadProps } from "@/types";

type Props = HeadProps;

const head = Astro.props;
---

<!doctype html>
<html lang="en">
  <Head {...head} />
  <body class="flex flex-col min-h-dvh bg-ctp-latte-base text-ctp-latte-text dark:bg-ctp-mocha-base dark:text-ctp-mocha-text font-sans antialiased">
    <slot />
  </body>
</html>
