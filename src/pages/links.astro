---
import Layout from "@/layouts/Layout.astro";
import { SITE_DESCRIPTION } from "@/consts";
import Command from "@/components/subpage/Command.astro";
import BackCommand from "@/components/subpage/BackCommand.astro";
import Link from "@/components/links/Link.astro";

import LinkDuotone from "~icons/ph/link-duotone";
import { Image } from "astro:assets";
---

<Layout title={"Links"} description={SITE_DESCRIPTION}>
  <header class="py-24 px-4 md:px-16 lg:px-32 border-b-2 border-dashed border-ctp-latte-surface-0 dark:border-ctp-mocha-surface-0">
    <BackCommand />
    <Command>cat links.md</Command>
    <h1 class="mt-4 flex gap-2 font-bold text-5xl text-ctp-latte-flamingo dark:text-ctp-mocha-flamingo">
      <LinkDuotone aria-hidden /> Links
    </h1>
    <div class="mt-4 text-xl font-italic">Where others come and go.</div>
  </header>
  <main class="px-4 md:px-16 lg:px-32 py-8">
    <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <Link
        name="Guanran928 的博客"
        avatar="https://avatars.githubusercontent.com/u/68757440?s=460"
        size="460"
        description="(描述我写不出来的)"
        link="https://blog.ny4.dev"
      />
      <Link
        name="约伊兹的萌狼乡手札"
        avatar="https://avatars.githubusercontent.com/u/26817553?s=460"
        size="460"
        description="「虽然咱长久以来被尊为神，且被束缚在这块土地上，但咱根本不是什么伟大的神。咱就是咱。咱是赫萝。」"
        link="https://blog.yoitsu.moe"
      />
      <Link
        name="Astrarix Archive"
        avatar="https://avatars.githubusercontent.com/u/119999228?s=460"
        size="460"
        description="乱七八糟的个人站"
        link="https://www.kokosa.icu/"
      />
      <Link
        name="惠狐之书"
        avatar="https://avatars.githubusercontent.com/u/23371099?s=460"
        size="460"
        description="一只叫惠的小狐狸的探索故事。"
        link="https://blog.megumifox.com/public/"
      />
      <Link
        name="千須末記事屋"
        avatar="https://avatars.githubusercontent.com/u/17294071?s=460"
        size="460"
        description="(描述我写不出来的)"
        link="https://blog.origincode.me/"
      />
      <Link
        name="Vifly 的博客"
        avatar="https://avatars.githubusercontent.com/u/48406926?s=460"
        size="460"
        description="(描述我写不出来的)"
        link="https://viflythink.com/"
      />
      <Link
        name="玖只的尾巴"
        avatar="https://blog.yurzi.net/icon.webp"
        size="600"
        description="这里有着一些毛茸茸的东西，包括但不限于知识、猫猫、尾巴等"
        link="https://blog.yurzi.net/"
      />
      <Link
        name="Justin Chen's Blog"
        avatar="https://avatars.githubusercontent.com/u/42143810?s=460"
        size="460"
        description="A world where insightful idea sparks"
        link="https://blog.starryreverie.cc/"
      />
    </ul>
  </main>
</Layout>
