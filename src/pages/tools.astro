---
import Layout from "@/layouts/Layout.astro";
import { SITE_DESCRIPTION } from "@/consts";
import Command from "@/components/subpage/Command.astro";
import BackCommand from "@/components/subpage/BackCommand.astro";

import WrenchDuotone from "~icons/ph/wrench-duotone";
---

<Layout title={"Projects"} description={SITE_DESCRIPTION}>
  <header class="px-12 md:px-16 py-32">
    <BackCommand />
    <Command>cat tools.md</Command>
    <h1 class="mt-4 flex gap-2 font-bold text-5xl text-ctp-latte-flamingo dark:text-ctp-mocha-flamingo">
      <WrenchDuotone aria-hidden /> Tools
    </h1>
    <div class="mt-4 text-xl font-italic">My toolchains.</div>
  </header>
  <main class="px-12 md:px-16">TODO</main>
</Layout>
